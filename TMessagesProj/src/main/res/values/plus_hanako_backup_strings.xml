<resources>
    <string name="HanakoBackupTitle">Backup &amp; export</string>
    <string name="HanakoBackupEntryInfo">Export or import Hanako settings, move your logged-in accounts to another install or phone, or export a chat.</string>
    <string name="HanakoBackupFullHeader">Full backup</string>
    <string name="HanakoBackupCreate">Create full backup</string>
    <string name="HanakoBackupRestore">Restore full backup</string>
    <string name="HanakoBackupFullInfo">Moves your logged-in accounts and Hanako settings to a new install, package or phone without logging in again. The file is encrypted with a password you choose.</string>
    <string name="HanakoBackupSettingsHeader">Settings</string>
    <string name="HanakoBackupExportSettings">Export settings</string>
    <string name="HanakoBackupImportSettings">Import settings</string>
    <string name="HanakoBackupSettingsInfo">Hanako and Mercurygram options only (not Telegram\'s own settings, chats or accounts), saved as a JSON file.</string>
    <string name="HanakoBackupChatHeader">Chat export</string>
    <string name="HanakoBackupExportChat">Export a chat</string>
    <string name="HanakoBackupChatInfo">Saves one chat\'s history as HTML and/or JSON (Telegram Desktop format), with the media you choose.</string>
    <string name="HanakoBackupRestoreLogin">Restore from Hanako backup</string>
    <string name="HanakoBackupWarningTitle">Keep this file secret</string>
    <string name="HanakoBackupWarning">Anyone who has this file and its password gets full access to your accounts: chats, contacts, everything, with no login code or 2-step verification password. Use a strong password and keep the file somewhere safe.</string>
