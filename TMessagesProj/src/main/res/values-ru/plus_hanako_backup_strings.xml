    <string name="HanakoBackupPasswordRepeat">Повторите пароль</string>
    <string name="HanakoBackupPasswordInfo">Минимум 12 символов, или нажмите «Сгенерировать». Если забыть пароль, копию не открыть.</string>
    <string name="HanakoBackupPasswordEnter">Введите пароль, с которым была создана копия.</string>
